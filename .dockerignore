# İmajlar deponun kökünden derlenir (bkz. backend/Dockerfile). Varsayılan olarak
# hiçbir dosya Docker'a gönderilmez; yalnızca derleme için gerekenler açılır.
# Böylece .env ve deploy/k8s/overlays/dev/secrets/ gibi gizli dosyalar derleme
# bağlamına hiçbir zaman girmez.
*

!backend/.mvn
!backend/mvnw
!backend/pom.xml
!backend/src
!db/migrations

!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/vite.config.ts
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.node.json
!frontend/nginx.conf
!frontend/src
!frontend/public

!worker/pyproject.toml
!worker/uv.lock
!worker/.python-version
!worker/src

# Açılan klasörlerin içindeki Python önbellek dosyaları yine gönderilmez.
**/__pycache__
