{
  "settings": {
    "analysis": {
      "filter": {
        "turkish_lowercase": {
          "type": "lowercase",
          "language": "turkish"
        },
        "turkish_stop": {
          "type": "stop",
          "stopwords": "_turkish_"
        },
        "turkish_stemmer": {
          "type": "stemmer",
          "language": "turkish"
        },
        "english_possessive_stemmer": {
          "type": "stemmer",
          "language": "possessive_english"
        },
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        },
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        },
        "first_letters": {
          "type": "truncate",
          "length": 5
        }
      },
      "analyzer": {
        "turkish_article": {
          "type": "custom",
          "char_filter": [
            "html_strip"
          ],
          "tokenizer": "standard",
          "filter": [
            "apostrophe",
            "turkish_lowercase",
            "turkish_stop",
            "turkish_stemmer"
          ]
        },
        "turkish_folded": {
          "type": "custom",
          "char_filter": [
            "html_strip"
          ],
          "tokenizer": "standard",
          "filter": [
            "apostrophe",
            "turkish_lowercase",
            "asciifolding",
            "first_letters"
          ]
        },
        "english_article": {
          "type": "custom",
          "char_filter": [
            "html_strip"
          ],
          "tokenizer": "standard",
          "filter": [
            "english_possessive_stemmer",
            "lowercase",
            "english_stop",
            "english_stemmer"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "source_code": {
        "type": "keyword"
      },
      "language": {
        "type": "keyword"
      },
      "item_type": {
        "type": "keyword"
      },
      "categories": {
        "type": "keyword"
      },
      "published_at": {
        "type": "date"
      },
      "group_id": {
        "type": "keyword"
      },
      "hidden": {
        "type": "boolean"
      },
      "author": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      },
      "title_tr": {
        "type": "text",
        "analyzer": "turkish_article",
        "fields": {
          "folded": {
            "type": "text",
            "analyzer": "turkish_folded"
          }
        }
      },
      "summary_tr": {
        "type": "text",
        "analyzer": "turkish_article",
        "fields": {
          "folded": {
            "type": "text",
            "analyzer": "turkish_folded"
          }
        }
      },
      "content_tr": {
        "type": "text",
        "analyzer": "turkish_article",
        "fields": {
          "folded": {
            "type": "text",
            "analyzer": "turkish_folded"
          }
        }
      },
      "title_en": {
        "type": "text",
        "analyzer": "english_article"
      },
      "summary_en": {
        "type": "text",
        "analyzer": "english_article"
      },
      "content_en": {
        "type": "text",
        "analyzer": "english_article"
      }
    }
  }
}
