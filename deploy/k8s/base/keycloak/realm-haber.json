{
  "realm": "haber",
  "enabled": true,
  "displayName": "Haber Arama Platformu",
  "sslRequired": "external",

  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,

  "passwordPolicy": "length(12) and notUsername and notEmail",

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,

  "internationalizationEnabled": true,
  "supportedLocales": ["tr", "en"],
  "defaultLocale": "tr",

  "accessTokenLifespan": 300,

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@haber.local",
    "fromDisplayName": "Haber Arama Platformu",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },

  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,

  "clients": [
    {
      "clientId": "haber-frontend",
      "name": "Haber Arama Platformu",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://haber.local/oidc-callback"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://haber.local/"
      },
      "protocolMappers": [
        {
          "name": "haber-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "haber-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}